# Обратный прокси на приложение с автоматическим TLS (Let's Encrypt).
# DOMAIN и ACME_EMAIL берутся из .env (env_file в docker-compose.yaml).
# Caddy сам выпускает и продлевает сертификат — вручную ничего настраивать не нужно,
# только чтобы DNS домена указывал на этот сервер и были открыты порты 80/443.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Отдаём внутреннему api:8000 (имя сервиса в docker-compose, порт наружу
	# у api не публикуется — только этот прокси).
	reverse_proxy api:8000
}
