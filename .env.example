OPENAI_API_KEY=sk-********
PINECONE_API_KEY=your-pinecone-key

# Pinecone — индекс наименований (русские описания товаров)
PINECONE_NAMES_INDEX_NAME=gq-names
PINECONE_NAMES_INDEX_HOST=https://gq-names-xxxx.svc.pinecone.io

# Pinecone — индекс артикулов (коды товаров: PP24-1UC5ES-D05, A9D31620...)
PINECONE_ARTICUL_INDEX_NAME=gq-articuls
PINECONE_ARTICUL_INDEX_HOST=https://gq-articuls-xxxx.svc.pinecone.io
API_TOKEN=your_jwt_secret
DB_HOST=postgres_host
DB_PORT=postgres_port(default=5432)
DB_USER=your_username
DB_PASS=your_password
DB_NAME=your_db_name

# Бот №1 — уведомления менеджерам (заказы и эскалации → группа)
TELEGRAM_BOT_TOKEN=your-notification-bot-token   # Получить у @BotFather
TELEGRAM_CHAT_ID=**********                  # ID группы менеджеров

# Бот №2 — входящий (клиенты пишут ИИ через этого бота)
TELEGRAM_INPUT_BOT_TOKEN=your-input-bot-token    # Отдельный бот, тоже от @BotFather
INTERNAL_API_URL=http://localhost:8000            # URL FastAPI (внутри Docker: http://api:8000)
