# ВАЖНО: docker compose НЕ обрезает комментарии после значения.
# Строка вида `KEY=value   # пояснение` попадёт в переменную целиком, вместе с
# решёткой и текстом. Поэтому все пояснения здесь стоят ОТДЕЛЬНОЙ строкой.

OPENAI_API_KEY=sk-********
PINECONE_API_KEY=your-pinecone-key

# Pinecone — индекс наименований (русские описания товаров)
PINECONE_NAMES_INDEX_NAME=gq-names
PINECONE_NAMES_INDEX_HOST=https://gq-names-xxxx.svc.pinecone.io

# Pinecone — индекс артикулов (коды товаров: PP24-1UC5ES-D05, A9D31620...)
PINECONE_ARTICUL_INDEX_NAME=gq-articuls
PINECONE_ARTICUL_INDEX_HOST=https://gq-articuls-xxxx.svc.pinecone.io

# Секрет подписи JWT веб-консоли менеджеров.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Ротация этого значения разлогинивает всех менеджеров.
API_TOKEN=your_jwt_secret

# ─── Основная база (товары, поставщики) ──────────────────────
DB_HOST=postgres_host
DB_PORT=5432
DB_USER=your_username
DB_PASS=your_password
DB_NAME=your_db_name

# ─── Отдельная база под переписку веб-консоли ────────────────
# Создаётся приложением автоматически при старте (ensure_chat_database).
# Отдельная намеренно: DELETE /api/v1/drop_DB не должен сносить переписку.
CHAT_DB_NAME=gq_chat

# ─── Веб-консоль менеджеров ──────────────────────────────────
# Время жизни токена в часах.
CONSOLE_JWT_TTL_HOURS=12
# Каталог собранного фронтенда (в образе — /srv/console; локально — frontend/dist).
CONSOLE_DIST_DIR=/srv/console
# Origin-ы для CORS, через запятую. Нужны только для vite dev-сервера:
# в проде консоль раздаётся тем же приложением и CORS не задействован.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Telegram ────────────────────────────────────────────────
# Бот №1 — уведомления менеджерам (заказы и эскалации → группа). От @BotFather.
TELEGRAM_BOT_TOKEN=your-notification-bot-token
# ID группы менеджеров
TELEGRAM_CHAT_ID=**********

# Бот №2 — входящий (клиенты пишут ИИ через этого бота). Отдельный бот от @BotFather.
# ВНИМАНИЕ: невалидный НЕПУСТОЙ токен роняет всё приложение при старте
# (aiogram кидает TokenValidationError из lifespan). Чтобы отключить бота —
# оставьте значение ПУСТЫМ, а не placeholder'ом.
TELEGRAM_INPUT_BOT_TOKEN=

# URL FastAPI (внутри Docker: http://api:8000)
INTERNAL_API_URL=http://localhost:8000

# Персональные chat_id менеджеров. Пока TELEGRAM_TEST_MODE=true
# все уведомления всё равно уходят в TELEGRAM_TEST_CHAT_ID.
TELEGRAM_TEST_MODE=true
TELEGRAM_TEST_CHAT_ID=
TG_CHAT_ID_DIRECTOR=
TG_CHAT_ID_KALBAEVA=
TG_CHAT_ID_SABIEVA=
TG_CHAT_ID_ZHENIBEK=
TG_CHAT_ID_DOLAKOV=

# ─── WhatsApp (Gupshup) ──────────────────────────────────────
GUPSHUP_API_KEY=your-gupshup-api-key
GUPSHUP_APP_NAME=GQGroup
# Номер бота без «+», например 77000000000
GUPSHUP_SOURCE_PHONE=
# Токен, который вводится в Gupshup при настройке webhook
GUPSHUP_VERIFY_TOKEN=gqgroup_verify

# Разработка: не дёргать Gupshup, но писать исходящие в веб-консоль.
# На проде должно быть false.
WHATSAPP_DRY_RUN=false
